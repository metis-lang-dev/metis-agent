action ::= "\"STAND_UP\"" | "\"SIT_DOWN\"" | "\"LIE_DOWN\"" | "\"STRETCH\"" | "\"SHAKE\"" | "\"TURN\"" | "\"MOVE\""
action-kv ::= "\"action\"" space ":" space action
action-rest ::= ( "," space direction-kv )? direction-rest
angle-deg-kv ::= "\"angle_deg\"" space ":" space number
angle-deg-rest ::= ( "," space duration-kv )? duration-rest
char ::= [^"\\] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])
constraints ::= "[" space (constraints-item ("," space constraints-item)*)? "]" space
constraints-item ::= "{" space constraints-item-relation-kv "," space constraints-item-reference-kv "}" space
constraints-item-reference ::= "{" space constraints-item-reference-type-kv "," space constraints-item-reference-description-kv ( "," space ( constraints-item-reference-attributes-kv ) )? "}" space
constraints-item-reference-attributes ::= "{" space  (constraints-item-reference-attributes-color-kv constraints-item-reference-attributes-color-rest | constraints-item-reference-attributes-size-kv constraints-item-reference-attributes-size-rest | constraints-item-reference-attributes-material-kv )? "}" space
constraints-item-reference-attributes-color-kv ::= "\"color\"" space ":" space string
constraints-item-reference-attributes-color-rest ::= ( "," space constraints-item-reference-attributes-size-kv )? constraints-item-reference-attributes-size-rest
constraints-item-reference-attributes-kv ::= "\"attributes\"" space ":" space constraints-item-reference-attributes
constraints-item-reference-attributes-material-kv ::= "\"material\"" space ":" space string
constraints-item-reference-attributes-size-kv ::= "\"size\"" space ":" space string
constraints-item-reference-attributes-size-rest ::= ( "," space constraints-item-reference-attributes-material-kv )?
constraints-item-reference-description-kv ::= "\"description\"" space ":" space string
constraints-item-reference-kv ::= "\"reference\"" space ":" space constraints-item-reference
constraints-item-reference-type ::= "\"OBJECT\"" | "\"PERSON\"" | "\"POSITION\"" | "\"REGION\"" | "\"ROOM\"" | "\"LANDMARK\""
constraints-item-reference-type-kv ::= "\"type\"" space ":" space constraints-item-reference-type
constraints-item-relation ::= "\"NEAR\"" | "\"NEXT_TO\"" | "\"IN_FRONT_OF\"" | "\"BEHIND\"" | "\"ON\"" | "\"UNDER\"" | "\"LEFT_OF\"" | "\"RIGHT_OF\"" | "\"CLOSEST_TO\""
constraints-item-relation-kv ::= "\"relation\"" space ":" space constraints-item-relation
constraints-kv ::= "\"constraints\"" space ":" space constraints
decimal-part ::= [0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9])?)?)?)?)?)?)?)?)?)?)?)?)?)?)?
direction ::= "\"LEFT\"" | "\"RIGHT\"" | "\"AROUND\"" | "\"FORWARD\"" | "\"BACKWARD\""
direction-kv ::= "\"direction\"" space ":" space direction
direction-rest ::= ( "," space angle-deg-kv )? angle-deg-rest
duration-kv ::= "\"duration\"" space ":" space number
distance-m-kv ::= "\"distance_m\"" space ":" space number
distance-m-rest ::= ( "," space target-kv )? target-rest
duration-rest ::= ( "," space distance-m-kv )? distance-m-rest
goal ::= "{" space goal-type-kv "," space goal-description-kv ( "," space ( goal-attributes-kv ) )? "}" space
goal-attributes ::= "{" space  (goal-attributes-color-kv goal-attributes-color-rest | goal-attributes-size-kv goal-attributes-size-rest | goal-attributes-material-kv )? "}" space
goal-attributes-color-kv ::= "\"color\"" space ":" space string
goal-attributes-color-rest ::= ( "," space goal-attributes-size-kv )? goal-attributes-size-rest
goal-attributes-kv ::= "\"attributes\"" space ":" space goal-attributes
goal-attributes-material-kv ::= "\"material\"" space ":" space string
goal-attributes-size-kv ::= "\"size\"" space ":" space string
goal-attributes-size-rest ::= ( "," space goal-attributes-material-kv )?
goal-description-kv ::= "\"description\"" space ":" space string
goal-kv ::= "\"goal\"" space ":" space goal
goal-rest ::= ( "," space tag-id-kv )? tag-id-rest
tag-id-kv ::= "\"tag_id\"" space ":" space number
tag-id-rest ::= ( "," space constraints-kv )?
goal-type ::= "\"OBJECT\"" | "\"PERSON\"" | "\"POSITION\"" | "\"REGION\"" | "\"ROOM\"" | "\"LANDMARK\"" | "\"TAG\""
goal-type-kv ::= "\"type\"" space ":" space goal-type
integral-part ::= [0-9] | [1-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9])?)?)?)?)?)?)?)?)?)?)?)?)?)?)?
intent ::= "\"LOCAL_ACTION\"" | "\"QUERY\"" | "\"NAVIGATE\"" | "\"FIND\"" | "\"FOLLOW\"" | "\"STOP\"" | "\"CANCEL\"" | "\"TIME\"" | "\"DATE\"" | "\"CHITCHAT\"" | "\"UNKNOWN\""
intent-kv ::= "\"intent\"" space ":" space intent
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)? space
root ::= "{" space intent-kv ( "," space ( action-kv action-rest | direction-kv direction-rest | angle-deg-kv angle-deg-rest | duration-kv duration-rest | distance-m-kv distance-m-rest | target-kv target-rest | goal-kv goal-rest | tag-id-kv tag-id-rest | constraints-kv ) )? "}" space
space ::= " "?
string ::= "\"" char* "\"" space
target ::= "{" space target-type-kv "," space target-description-kv ( "," space ( target-attributes-kv ) )? "}" space
target-attributes ::= "{" space  (target-attributes-color-kv target-attributes-color-rest | target-attributes-size-kv target-attributes-size-rest | target-attributes-material-kv )? "}" space
target-attributes-color-kv ::= "\"color\"" space ":" space string
target-attributes-color-rest ::= ( "," space target-attributes-size-kv )? target-attributes-size-rest
target-attributes-kv ::= "\"attributes\"" space ":" space target-attributes
target-attributes-material-kv ::= "\"material\"" space ":" space string
target-attributes-size-kv ::= "\"size\"" space ":" space string
target-attributes-size-rest ::= ( "," space target-attributes-material-kv )?
target-description-kv ::= "\"description\"" space ":" space string
target-kv ::= "\"target\"" space ":" space target
target-rest ::= ( "," space goal-kv )? goal-rest
target-type ::= "\"OBJECT\"" | "\"PERSON\"" | "\"POSITION\"" | "\"REGION\"" | "\"ROOM\"" | "\"LANDMARK\""
target-type-kv ::= "\"type\"" space ":" space target-type