{"id": "W1", "catalog": "../metis-catalog/domains/planning/wolf-goat-cabbage/wgc.llp", "kind": "trace", "question": "The farmer carries the goat across first. Right after that crossing, on which bank are the farmer, the wolf, the goat and the cabbage?", "setup": [], "expect": "farmer far, wolf near, goat far, cabbage near", "must": [["farmer far", "farmer is on the far", "farmer on the far"], ["wolf near", "wolf is on the near", "wolf on the near", "wolf stays on the near", "wolf remains on the near", "wolf are on the near"], ["goat far", "goat is on the far", "goat on the far", "goat stays on the far", "goat remains on the far", "goat are on the far"], ["cabbage near", "cabbage is on the near", "cabbage on the near", "cabbage stays on the near", "cabbage remains on the near", "cabbage are on the near"]], "numbers": [], "instruments": ["step", "do", "state"], "max_calls": 8, "seen": true, "band_mark": false, "gold": [["step", "carry[A=near,X=goat,B=far]"], ["state", ""]], "stable": true, "forbid": []}
