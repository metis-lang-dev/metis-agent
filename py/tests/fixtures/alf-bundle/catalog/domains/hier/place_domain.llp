% place_domain — putting things (alf-hierarchy step 1, the architect, 2026-10-22): placing the
% held object into a receptacle as a specialist. Goal in: put(O, R); result out: placed(O, R), or
% refused_put(R) when the agent is elsewhere, R is shut, or the hands are empty.
catalog place_domain 1.
provenance text "ALFWorld put-down as a lifted specialist: move the held object to a receptacle" "2026-10-22".
layers (dyn).
stages (act).
types (receptacle location object).   % completed by the instance that includes this file (spec 12)
include "iface/alfworld.llp".   % the family's crossing preds, declared once (tools/iface_gen.py)

namespace place produce (dyn).
pred idle : place.                     % the tree: no goal taken
pred busy : place.                     % … a goal taken (reported active once)

pred recat(receptacle, location) : place.    % the projection's, as openable/notopenable (the map)
pred openable(receptacle) : place.
pred notopenable(receptacle) : place.

pred at(location) : place.
pred objat(object, location) : place.
pred inrecep(object, receptacle) : place.
pred opened(receptacle) : place.
pred closed(receptacle) : place.
pred holds(object) : place.
pred holding : place.
pred handsfree : place.

stage act {
  %% I take my goal.
  begin [dyn] : $put(X0, X1) * idle -o busy * tick__active(place).
  % >>> generated by metis.catalog.protocol_stub: the stop's cancels and the release's echo (regenerate, do not edit)
  %% Stopped: I drop my goal.
  cancel_put [dyn] : tick__cancel(place) * busy * put(V0, V1) -o idle.
  %% Stopped as I finished: nothing left to drop.
  cancel_none [dyn] : idle * tick__cancel(place) -o idle.   % the race: its done and the stop in one director beat (path_pop, stop_cancel: the sampled order)
  % <<< generated
  %% I put {O} in {R}.
  put_open [dyn] : put(O, R) * holds(O) * holding * $at(L) * $recat(R, L) * $openable(R) * $opened(R) * busy * $tick__grant(place, motion) -o inrecep(O, R) * objat(O, L) * handsfree * placed(O, R) * idle * tick__done(place).
  %% I put {O} on {R}.
  put_plain [dyn] : put(O, R) * holds(O) * holding * $at(L) * $recat(R, L) * $notopenable(R) * busy * $tick__grant(place, motion) -o inrecep(O, R) * objat(O, L) * handsfree * placed(O, R) * idle * tick__done(place).
  %% I am not at {R}.
  not_here [dyn] : put(O, R) * $at(L) * $recat(R, L2) * L <> L2 * busy -o elsewhere(R) * idle.
  %% {R} is shut.
  shut [dyn] : put(O, R) * $at(L) * $recat(R, L) * $closed(R) * busy -o refused_put(R) * idle * tick__stuck(place).
  %% I am not holding {O}.
  empty_handed [dyn] : put(O, R) * $handsfree * busy -o refused_put(R) * idle * tick__stuck(place).
}
