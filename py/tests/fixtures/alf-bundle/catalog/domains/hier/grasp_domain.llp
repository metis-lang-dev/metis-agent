% grasp_domain — taking things (alf-hierarchy step 1, the architect, 2026-10-22): picking an
% object up as a specialist. Goal in: take(O); result out: taken(O), or refused_take(O) when the agent
% is elsewhere, the receptacle is shut, or the hands are full (each with its reason line).
catalog grasp_domain 1.
provenance text "ALFWorld pick-up as a lifted specialist: take an object from where it is" "2026-10-22".
layers (dyn).
stages (act).
types (receptacle location object).   % completed by the instance that includes this file (spec 12)
include "iface/alfworld.llp".   % the family's crossing preds, declared once (tools/iface_gen.py)

namespace grasp produce (dyn).
pred idle : grasp.                     % the tree: no goal taken
pred busy : grasp.                     % … a goal taken (reported active once)

pred recat(receptacle, location) : grasp.    % the projection's, as openable/notopenable (the map)
pred openable(receptacle) : grasp.
pred notopenable(receptacle) : grasp.

pred at(location) : grasp.
pred objat(object, location) : grasp.
pred inrecep(object, receptacle) : grasp.
pred opened(receptacle) : grasp.
pred closed(receptacle) : grasp.
pred holds(object) : grasp.
pred holding : grasp.
pred handsfree : grasp.

stage act {
  %% I take my goal.
  begin [dyn] : $take(X0) * idle -o busy * tick__active(grasp).
  % >>> generated by metis.catalog.protocol_stub: the stop's cancels and the release's echo (regenerate, do not edit)
  %% Stopped: I drop my goal.
  cancel_take [dyn] : tick__cancel(grasp) * busy * take(V0) -o idle.
  %% Stopped as I finished: nothing left to drop.
  cancel_none [dyn] : idle * tick__cancel(grasp) -o idle.   % the race: its done and the stop in one director beat (path_pop, stop_cancel: the sampled order)
  % <<< generated
  %% I take {O} from {R}.
  take_open [dyn] : take(O) * $at(L) * $recat(R, L) * inrecep(O, R) * objat(O, L) * handsfree * $openable(R) * $opened(R) * busy * $tick__grant(grasp, motion) -o holds(O) * holding * taken(O) * idle * tick__done(grasp).
  %% I take {O} from {R}.
  take_plain [dyn] : take(O) * $at(L) * $recat(R, L) * inrecep(O, R) * objat(O, L) * handsfree * $notopenable(R) * busy * $tick__grant(grasp, motion) -o holds(O) * holding * taken(O) * idle * tick__done(grasp).
  %% I am not where {O} is.
  not_here [dyn] : take(O) * $at(L) * $inrecep(O, R) * $recat(R, L2) * L <> L2 * busy -o elsewhere(R) * idle.
  %% {R} is shut: I cannot reach {O}.
  shut [dyn] : take(O) * $at(L) * $recat(R, L) * $inrecep(O, R) * $closed(R) * busy -o refused_take(O) * idle * tick__stuck(grasp).
  %% My hands are full.
  hands_full [dyn] : take(O) * $at(L) * $objat(O, L) * $holding * busy -o refused_take(O) * idle * tick__stuck(grasp).
}
