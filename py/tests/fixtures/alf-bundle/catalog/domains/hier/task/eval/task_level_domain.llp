% GENERATED by world/gen_eval.py from ../../task_domain.llp (spec16 s-b12d90f2 step 3): the task with its
% go_for decided on a belief LEVEL with static weights (spec/16 §8's certified form), for the instrument only.
% task_domain — the pick-and-place task as the planner (alf-hierarchy step 1, the architect,
% 2026-10-22): it knows WHAT (the target object, the destination) and asks the specialists HOW,
% one sub-goal at a time — goto(R) to nav, open(R) to access, take(O) to grasp, put(O, R) to
% place — and waits for the result atom. It never acts in the world; it sees one world fact
% (which receptacle holds the target). A refusal it has no rule for ends in stuck(X): the
% disengagement point (metis-loop pi docs/POLICY.md). A question to the person (alf-demo step 3b, F3)
% ends its doc line with the answers it takes, `| answer | answer`: each a sentence the agent maps
% to an intent the card has (a fetch, or stop); the wire carries them as the ask's options. A fetch
% whose target is already in its destination is done at once (F8: it must not be undone); one whose
% target the agent holds (a stop after the take, F12) carries it to the destination. One way in: fetch(O, R) — the FETCH
% intent a person types, or the driver's seed (the first target, the first destination).
catalog task_level_domain 1.
provenance text "ALFWorld pick-and-place as the task domain over four specialists: sub-goals out, results in" "2026-10-22".
layers (dyn).
stages (act).
types (object receptacle thing).   % completed by the instance that includes this file (spec 12)
include "../../iface/alfworld.llp".   % the family's crossing preds, declared once (tools/iface_gen.py)

namespace task produce (dyn).

bwd target(object).                       % the task: an object the task wants moved
bwd dest(receptacle).                     % … and a receptacle it wants it in
bwd notdest(receptacle).                  % the complements, given by the instance (over roles: task/task.llp)
bwd nottarget(object).
bwd thing_of(object, thing).              % an object as a thing (stuck's type), and a receptacle: the instance's casts
bwd place_of(receptacle, thing).

% the belief that the object is in the receptacle (semantic-map s-d4270bed): the host answers it from
% the semantic map, normalized over the places asserted to hold it
weight look(O, R) reads {inrecep(O, R)}.
type certainty {unlikely maybe sure}.
pred place_level(certainty, object, receptacle) : task.   % the host's: the where belief's level (the manifest's levels: place_level)

pred inrecep(object, receptacle) : task.  % the world: where the target is
pred holds(object) : task.                % … or that the agent holds it (a stop after the take: opus's F12)
% what the robot found where it looked (the map's view mode, semantic-map step 3): its inrecep is then
% the map's belief (every place it may be in), look chooses among them; a place looked into without it
pred absent(object, receptacle) : task.
pred lost(thing) : task.                  % … and no place left to look (a thing: stuck's own type)
pred seen(object) : task.                 % the goal's thing is one the robot has seen (text mode: every thing)
pred unseen(object) : task.               % … or a kind it looks for, not seen yet (a room in view mode: alf-tasks step 2)
pred handsfree : task.                    % the robot's hand is empty (a fetch starts only so: alf-tasks step 3)
type chance {likely doubtful improbable}.
bwd go_on(chance).                        % the levels at which a search goes on (below them it stops)
pred presence(chance) : task.             % the map's existence level of an unseen kind: its room type's frequency, lowered
                                          % by every place looked into without it (the search stops at improbable: step 3)
pred freeing(object, receptacle) : task.  % a fetch waiting while the robot puts down what it holds
pred believed(object, receptacle) : task. % … in its destination by an earlier look, not seen there now: go and look
type risk {high mid low}.
pred fetch_risk(risk) : task.             % the host's level port (spec16 step 4): the fetch's failure risk within h
% what the person asks that this task cannot do (alf-tasks s-e9cc8fae step 2), mapped by the card (intent.yaml:
% NOTHERE, NOTASK): ALFWorld's own vocabulary — every object and receptacle kind of ALFRED's scenes, as the text
% names them (one word), and the chores of its other task families — never a thing of the room
% (alfkind, not kind: the director's routing type is kind, and one type has one member set: spec/15 I6)
type alfkind {
  alarmclock apple armchair baseballbat basketball bathtub bathtubbasin bed blinds book boots bowl box bread
  butterknife cabinet candle cart cd cellphone chair cloth coffeemachine coffeetable countertop creditcard cup
  curtains desk desklamp diningtable dishsponge drawer dresser egg floorlamp footstool fork fridge garbagecan
  glassbottle handtowel handtowelholder houseplant kettle keychain knife ladle laptop laundryhamper
  laundryhamperlid lettuce lightswitch microwave mirror mug newspaper ottoman painting paintinghanger pan
  papertowel papertowelroll pen pencil peppershaker pillow plate plunger poster pot potato remotecontrol safe
  saltshaker scrubbrush shelf showerdoor showerglass sidetable sink sinkbasin soapbar soapbottle sofa spatula
  spoon spraybottle statue stoveburner stoveknob teddybear television tennisracket tissuebox toaster toilet
  toiletpaper toiletpaperhanger toiletpaperroll tomato towel towelholder tvstand vase watch wateringcan window
  winebottle
}.
type chore {heating cooling cleaning slicing examining switching}.
pred nothere(alfkind) : task.                % a kind this room does not have (the card: the kinds it lacks)
pred notask(chore) : task.                % a chore, not an errand of moving a thing
pred unfit(object, receptacle) : task.    % a fetch the world does not allow (ALFWorld's cancontain), over the fetch's roles
% the sub-goals (out)
% the results (in)
% the one way in: the goal, typed by the person (the FETCH intent) or seeded by the driver
% the task's own tokens
pred start : task.                        % the first sub-goal not yet asked (once)
pred want(object) : task.                 % fetching the object
pred to(receptacle) : task.               % the destination this fetch names
pred carry(object) : task.                % carrying it to the destination

go_on(likely).
go_on(doubtful).

stage act {
  %% I'll fetch {O} to {R}.
  fetch [dyn] : fetch(O, R) * $target(O) * $dest(R) * $handsfree * $inrecep(O, R0) * R0 <> R -o want(O) * to(R) * start.
  %% {O} is already in {R}: nothing to do.
  already [dyn] : fetch(O, R) * $target(O) * $dest(R) * $inrecep(O, R) -o done.
  %% {O} may be in {R}: I go and look.
  verify [dyn] : fetch(O, R) * $target(O) * $dest(R) * $handsfree * $believed(O, R) -o want(O) * to(R) * goto(R).
  %% I have {X} in hand: I put it down here first.
  free_hands [dyn] : fetch(O, R) * $target(O) * $dest(R) * $holds(X) * $nottarget(X) -o freeing(O, R) * put(X, p0).
  %% {X} is down: now I fetch {O} to {R}.
  freed [dyn] : freeing(O, R) * placed(X, P) -o want(O) * to(R) * start.
  %% I can't put {X} down here: I stop and ask.
  stuck_free [dyn] : freeing(O, R) * refused_put(X) * $place_of(X, T) -o stuck(T).
  %% There is no {X} in this room: I looked everywhere it could be.
  nowhere [dyn] : fetch(O, R) * $target(O) * $dest(R) * $lost(X) -o stuck(X).
  %% I have {O}: to {R}.
  held [dyn] : fetch(O, R) * $target(O) * $dest(R) * $holds(O) -o carry(O) * to(R) * goto(R).
  %% {R} is not where this task wants {O}. | put {O} in {D} | stop
  not_dest [dyn] : fetch(O, R) * $target(O) * $notdest(R) * $dest(D) -o wrong_dest(R).
  %% {O} is not what this task fetches. | put {T} in {R} | stop
  not_target [dyn] : fetch(O, R) * $nottarget(O) * $target(T) -o wrong_object(O).
  %% {O} is surely in {R}: I go there.
  go_sure [dyn] : want(O) * start * $inrecep(O, R) * $place_level(sure, O, R) -o want(O) * goto(R).
  %% {O} may be in {R}: I go there.
  go_maybe [dyn] : want(O) * start * $inrecep(O, R) * $place_level(maybe, O, R) -o want(O) * goto(R).
  %% {O} is unlikely in {R}: I go there, a tenth as readily.
  go_unlikely [dyn] : want(O) * start * $inrecep(O, R) * $place_level(unlikely, O, R) -o want(O) * goto(R)  @w 0.1.
  %% No {O} seen yet: I look in {R} first.
  look_first [dyn] : want(O) * start * $unseen(O) * $presence(C) * $go_on(C) * $inrecep(O, R) -o want(O) * goto(R)  @w look(O, R).
  %% No {O} seen yet: it may be in {R} already, I look there too.
  look_dest [dyn] : want(O) * start * $unseen(O) * $presence(C) * $go_on(C) * $to(R) * $believed(O, R) -o want(O) * goto(R)  @w look(O, R).
  %% There is probably no {T} in this room: I stop looking.
  gave_up [dyn] : want(O) * start * $unseen(O) * $presence(improbable) * $thing_of(O, T) -o gave_up(T).
  %% At {R}: I need it open.
  open_for [dyn] : want(O) * reached(R) * $inrecep(O, R) -o want(O) * open(R).
  %% {R} is accessible: I take {O}.
  take_for [dyn] : want(O) * accessible(R) * $inrecep(O, R) * $notdest(R) -o want(O) * take(O).
  %% At {R}: I need it open to see.
  open_look [dyn] : want(O) * reached(R) * $to(R) * $believed(O, R) -o want(O) * open(R).
  %% {O} is in {R}: done.
  verified [dyn] : want(O) * accessible(R) * $to(R) * $inrecep(O, R) -o done.
  %% {O} is not in {R}: I look elsewhere.
  not_here [dyn] : want(O) * reached(R) * $absent(O, R) -o want(O) * start.
  %% {O} is not in {R}: I look elsewhere.
  not_in [dyn] : want(O) * accessible(R) * $absent(O, R) -o want(O) * start.
  %% There is no {X} in this room: I looked everywhere it could be.
  lost_it [dyn] : want(O) * start * $lost(X) -o stuck(X).
  %% I have {O}: to {R}.
  go_dest [dyn] : want(O) * taken(O) * $to(R) -o carry(O) * goto(R).
  %% At {R}: I need it open.
  open_dest [dyn] : carry(O) * reached(R) * $to(R) -o carry(O) * open(R).
  %% {R} is accessible: I put {O} in.
  put_dest [dyn] : carry(O) * accessible(R) * $to(R) -o carry(O) * put(O, R).
  %% {O} is in {R}: done.
  finish [dyn] : carry(O) * placed(O, R) -o done.
  %% There is no {K} in this room.
  absent_kind [dyn] : nothere(K) -o nothing.
  %% Sorry, {C} is not a task I know: I move things from place to place.
  not_a_chore [dyn] : notask(C) -o cannot.
  %% {O} cannot go in or on {R}: this world does not allow it.
  cannot_fit [dyn] : unfit(O, R) -o misfit(O, R).
  %% {X} was refused and I have no rule for it: I stop and ask.
  stuck_fetch [dyn] : want(O) * refused(X) -o stuck(X).
  %% {X} was refused and I have no rule for it: I stop and ask.
  stuck_carry [dyn] : carry(O) * refused(X) -o stuck(X).
  %% {X} was refused and I have no rule for it: I stop and ask.
  stuck_take [dyn] : want(O) * refused_take(X) * $thing_of(X, T) -o stuck(T).
  %% {X} was refused and I have no rule for it: I stop and ask.
  stuck_put [dyn] : carry(O) * refused_put(X) * $place_of(X, T) -o stuck(T).
}
