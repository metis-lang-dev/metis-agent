% DERIVED from ../nav_domain.llp by world/gen_hier.py plain (make plain): the plain hierarchy's base; edit that file, never this one.
% nav_domain — going places (alf-hierarchy step 1, the architect, 2026-10-22): the household's
% navigation as a specialist. Goal in: goto(R); result out: reached(R). It sees one dynamic
% fact (where the agent is) and where each receptacle is. Its committed instance (nav/nav.llp)
% includes this file and the role vocabulary (../capacity.llp: semantic-map s-d4270bed, roles not
% rooms); the host projects the semantic map onto the roles and asserts both facts.
catalog nav_domain 1.
provenance text "ALFWorld navigation as a lifted specialist: go to a receptacle; the task domain asks, the result answers" "2026-10-22".
layers (dyn).
stages (act).
types (receptacle location).   % completed by the instance that includes this file (spec 12)
include "../iface/alfworld.llp".   % the family's crossing preds, declared once (tools/iface_gen.py)

namespace nav produce (dyn).

pred recat(receptacle, location) : nav.          % the receptacle's location: the projection's (the map)

pred at(location) : nav.                  % the world: exactly one

stage act {
  %% I go to {R}.
  go [dyn] : goto(R) * at(L) * $recat(R, L2) * L <> L2 -o at(L2) * reached(R).
  %% {R} is right here.
  here [dyn] : goto(R) * $at(L) * $recat(R, L) -o reached(R).
}
