% DERIVED from ../place_domain.llp by world/gen_hier.py plain (make plain): the plain hierarchy's base; edit that file, never this one.
% place_domain — putting things (alf-hierarchy step 1, the architect, 2026-10-22): placing the
% held object into a receptacle as a specialist. Goal in: put(O, R); result out: placed(O, R), or
% refused_put(R) when the agent is elsewhere, R is shut, or the hands are empty.
catalog place_domain 1.
provenance text "ALFWorld put-down as a lifted specialist: move the held object to a receptacle" "2026-10-22".
layers (dyn).
stages (act).
types (receptacle location object).   % completed by the instance that includes this file (spec 12)
include "../iface/alfworld.llp".   % the family's crossing preds, declared once (tools/iface_gen.py)

namespace place produce (dyn).

pred recat(receptacle, location) : place.    % the projection's, as openable/notopenable (the map)
pred openable(receptacle) : place.
pred notopenable(receptacle) : place.

pred at(location) : place.
pred objat(object, location) : place.
pred inrecep(object, receptacle) : place.
pred opened(receptacle) : place.
pred closed(receptacle) : place.
pred holds(object) : place.
pred holding : place.
pred handsfree : place.

stage act {
  %% I put {O} in {R}.
  put_open [dyn] : put(O, R) * holds(O) * holding * $at(L) * $recat(R, L) * $openable(R) * $opened(R) -o inrecep(O, R) * objat(O, L) * handsfree * placed(O, R).
  %% I put {O} on {R}.
  put_plain [dyn] : put(O, R) * holds(O) * holding * $at(L) * $recat(R, L) * $notopenable(R) -o inrecep(O, R) * objat(O, L) * handsfree * placed(O, R).
  %% I am not at {R}.
  not_here [dyn] : put(O, R) * $at(L) * $recat(R, L2) * L <> L2 -o elsewhere(R).
  %% {R} is shut.
  shut [dyn] : put(O, R) * $at(L) * $recat(R, L) * $closed(R) -o refused_put(R).
  %% I am not holding {O}.
  empty_handed [dyn] : put(O, R) * $handsfree -o refused_put(R).
}
