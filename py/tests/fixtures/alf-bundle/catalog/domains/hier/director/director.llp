% director — the director over the ALFWorld hierarchy, the bundle's (generated by world/gen_hier.py bundle).
catalog director 1.
provenance text "generated: the director over nav/access/grasp/place/task" "2026-11-03".
include "../../director_domain.llp".
include "iface/director_tree_domain.llp".
include "iface/director_tree_wake.llp".
type domain {nav access grasp place task}.
type kind {accessible cannot done elsewhere fetch gave_up goto misfit nothing open placed put reached refused refused_put refused_take stuck take taken wrong_dest wrong_object}.

specialist(nav).
specialist(access).
specialist(grasp).
specialist(place).
planner(task).
handles(nav, goto).
handles(access, open).
handles(grasp, take).
handles(place, put).
handles(task, fetch).
handles(task, reached).
handles(task, accessible).
handles(task, taken).
handles(task, placed).
handles(task, refused_take).
handles(task, refused_put).
handles(task, refused).
result(reached).
result(accessible).
result(taken).
result(placed).
end(stuck).
end(wrong_dest).
end(wrong_object).
end(nothing).
end(cannot).
end(misfit).
finished(done).
finished(gave_up).
detour(elsewhere, goto).
escalate(elsewhere, refused).
rename(elsewhere, goto, goto).
rename(elsewhere, refused, refused).

type resource {motion}.
mature_grant(a1).
mature_grant(a2).
mature_grant(a3).
young_grant(a0).
mature_status(a1).
mature_status(a2).
mature_status(a3).

