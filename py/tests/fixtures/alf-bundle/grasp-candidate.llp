% grasp — the grasp specialist over the role vocabulary (semantic-map s-d4270bed): compiled once, the room in the host's semantic map (generated by world/gen_hier.py).
catalog grasp 1.
provenance text "the grasp specialist over roles: the host projects the map onto them" "2026-10-24".
include "../grasp_domain.llp".
include "../capacity.llp".
include "iface/protocol_domain.llp".
include "../tick_types.llp".

pred noted_take(object) : grasp.
stage act {
  %% I note that I hold {O}.
  noted [dyn] : $holds(O) * $holding -o noted_take(O).
}

#steps 8
#seeds 1
#init idle 1
